{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Source Designer",
  "version": "0.1.1",
  "identifier": "com.reder.ai-source-designer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1433",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Source Designer",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1480,
        "height": 960,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../playwright/worker/": "playwright/worker/",
      "../fixtures/": "fixtures/"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
